generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Candidate {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String
  email          String   @unique
  phone          String
  position       String
  yearsOfExp     Int
  coverLetterUrl String?
  resumeUrl      String
  status         String   @default("pending")
  createdAt      DateTime @default(now())
}
